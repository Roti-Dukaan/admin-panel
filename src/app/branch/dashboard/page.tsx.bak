'use client';

import * as React from 'react';

const orders = {
  title: 'Orders',
  count: 12,
  metrics: { latest_declaration: 'Active' },
  items: [
    { id: '#ORD-001', created_at: '2026-07-23T10:00:00Z', status: 'preparing' },
    { id: '#ORD-002', created_at: '2026-07-23T09:30:00Z', status: 'pending' },
  ],
};

const customers = {
  title: 'Customers',
  count: 8,
  metrics: { active: '5 Active' },
  items: [
    { name: 'Rahul Sharma', email: 'rahul@example.com', region: 'Hyderabad' },
    { name: 'Priya Patel', email: 'priya@example.com', region: 'Bangalore' },
  ],
};

function formatDate(iso: string) {
  const d = new Date(iso);
  return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
}

export default function BranchDashboardPage() {
  return (
    <div className="space-y-6">
      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div className="rounded-2xl border border-gray-200/80 bg-white p-5">
          <p className="text-sm font-medium text-gray-500">Today's Orders</p>
          <p className="mt-2 text-3xl font-bold text-gray-900">12</p>
        </div>
        <div className="rounded-2xl border border-gray-200/80 bg-white p-5">
          <p className="text-sm font-medium text-gray-500">Today's Revenue</p>
          <p className="mt-2 text-3xl font-bold text-gray-900">₹50,000</p>
        </div>
        <div className="rounded-2xl border border-gray-200/80 bg-white p-5">
          <p className="text-sm font-medium text-gray-500">Active Tickets</p>
          <p className="mt-2 text-3xl font-bold text-gray-900">5</p>
        </div>
        <div className="rounded-2xl border border-gray-200/80 bg-white p-5">
          <p className="text-sm font-medium text-gray-500">Kitchen Status</p>
          <p className="mt-2 text-3xl font-bold text-gray-900">OPEN</p>
        </div>
          {/* Orders Card */}
          <div className="card shadow-sm p-4 border border-gray-300 rounded-lg">
            <h3 className="text-xl font-bold text-gray-800 mb-2">{orders.title}</h3>
            <div className="flex justify-between items-center mb-2">
              <p className="text-gray-700">{orders.count} orders</p>
              <span className="text-teal-600">{orders.metrics.latest_declaration}</span>
            </div>
            <table className="min-h-40 flex-1 overflow-y-auto p-2 border border-gray-200 rounded-lg">
              <thead className="text-gray-700 py-2">
                <tr>
                  <th className="pl-4">Order ID</th>
                  <th>Date</th>
                  <th className="pr-4">Status</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-200">
                {orders.items.map((item) => (
                  <tr key={item.id}>
                    <td>{item.id}</td>
                    <td>{formatDate(item.created_at)}</td>
                    <td className="text-gray-800">{item.status}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* Customers Card */}
          <div className="card shadow-sm p-4 border border-gray-300 rounded-lg">
            <h3 className="text-xl font-bold text-gray-800 mb-2">{customers.title}</h3>
            <div className="flex justify-between items-center mb-2">
              <p className="text-gray-700">{customers.count} customers</p>
              <span className="text-blue-600">{customers.metrics.active}</span>
            </div>
            <table className="min-h-40 flex-1 overflow-y-auto p-2 border border-gray-200 rounded-lg">
              <thead className="text-gray-700 py-2">
                <tr>
                  <th className="pl-4">Name</th>
