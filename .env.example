# Local backend (default for npm run dev)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Vercel (Production + Preview on development branch) — required; build fails if missing:
# NEXT_PUBLIC_API_URL=https://backend-dev.rotidukaan.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Alias supported by src/lib/google-maps.ts:
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
